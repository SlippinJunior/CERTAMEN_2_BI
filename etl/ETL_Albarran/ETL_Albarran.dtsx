                <component
                  refId="Package\SEQ Carga Dimensiones\DFT DimEmpleado\SRC Empleados"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC Empleados"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT e.empleado_id AS EmpleadoID,
       CAST(LTRIM(RTRIM(e.nombre)) AS nvarchar(100))                     AS Nombre,
       CAST(LTRIM(RTRIM(ISNULL(e.appaterno, N''))) AS nvarchar(100))     AS ApellidoPaterno,
       CAST(LTRIM(RTRIM(ISNULL(e.apmaterno, N''))) AS nvarchar(100))     AS ApellidoMaterno,
       ISNULL(e.cargo_id, -1)                                            AS CargoID,
       CAST(LOWER(LTRIM(RTRIM(ISNULL(ca.nombre, N'desconocido')))) AS nvarchar(100)) AS CargoOrigen,
       CAST(e.fecha_contrato AS date)                                    AS FechaContrato,
       CAST(CASE WHEN e.fecha_contrato IS NULL THEN NULL
            ELSE DATEDIFF(YEAR, e.fecha_contrato, GETDATE())
                 - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, e.fecha_contrato, GETDATE()), e.fecha_contrato) &gt; GETDATE() THEN 1 ELSE 0 END
            END AS int)                                                  AS AniosAntiguedad,
       CAST(ISNULL(e.sueldo_base, 0) AS decimal(18,2))                   AS SueldoBase
FROM dbo.empleados AS e
LEFT JOIN dbo.cargos AS ca ON ca.cargo_id = e.cargo_id;</property>
                    <property
