                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT s.sucursal_id AS SucursalID,
       CAST(LTRIM(RTRIM(s.sucursal)) AS nvarchar(100))                   AS NombreSucursal,
       ISNULL(s.comuna_id, -1)                                           AS ComunaID,
       CAST(LTRIM(RTRIM(ISNULL(co.comuna, N'Desconocida'))) AS nvarchar(100)) AS Comuna
FROM dbo.sucursales AS s
LEFT JOIN dbo.comunas AS co ON co.comuna_id = s.comuna_id;</property>
