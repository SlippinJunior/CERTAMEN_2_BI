    <DTS:Executable
      DTS:refId="Package\SQL Cargar DimTiempo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Genera la dimensión tiempo (un registro por día)"
      DTS:DTSID="{CAB4BC08-EC86-4D61-92E1-D2469196D608}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Cargar DimTiempo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8A595ED8-0002-4E3D-BC6C-6DDADF0CBCEB}"
          SQLTask:SqlStatementSource="EXEC dbo.usp_CargarDimTiempo @FechaInicio = '20170101', @FechaFin = '20181231';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Preparar Carga"
