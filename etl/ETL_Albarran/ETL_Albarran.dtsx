                <component
                  refId="Package\SEQ Carga Dimensiones\DFT DimCliente\SRC Clientes"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC Clientes"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT c.cliente_id AS ClienteID,
       CAST(LTRIM(RTRIM(c.nombre)) AS nvarchar(100))                     AS Nombre,
       CAST(LTRIM(RTRIM(ISNULL(c.appaterno, N''))) AS nvarchar(100))     AS ApellidoPaterno,
       CAST(LTRIM(RTRIM(ISNULL(c.apmaterno, N''))) AS nvarchar(100))     AS ApellidoMaterno,
       CAST(UPPER(LTRIM(RTRIM(ISNULL(c.sexo, '')))) AS nvarchar(1))      AS SexoCodigo,
       CAST(c.fecha_nacimiento AS date)                                  AS FechaNacimiento,
       CAST(CASE WHEN c.fecha_nacimiento IS NULL THEN NULL
            ELSE DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE())
                 - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, c.fecha_nacimiento, GETDATE()), c.fecha_nacimiento) &gt; GETDATE() THEN 1 ELSE 0 END
            END AS int)                                                  AS Edad,
       CAST(LOWER(LTRIM(RTRIM(ISNULL(c.estado_civil, N'')))) AS nvarchar(30)) AS EstadoCivilOrigen
FROM dbo.clientes AS c;</property>
                    <property
