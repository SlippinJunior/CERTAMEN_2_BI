            <component
              refId="Package\DFT FactVentas\SRC Ventas Detalle"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC Ventas Detalle"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT v.venta_id                                               AS VentaID,
       ISNULL(v.numero_documento, v.venta_id)                       AS NumeroDocumento,
       CAST(v.fecha AS date)                                        AS Fecha,
       v.cliente_id                                                 AS ClienteID,
       v.vendedor_id                                                AS EmpleadoID,
       v.sucursal_id                                                AS SucursalID,
       CAST(LOWER(LTRIM(RTRIM(ISNULL(v.tipo_documento, N'')))) AS nvarchar(20)) AS TipoDocumentoCodigo,
       d.producto_id                                                AS ProductoID,
       d.cantidad                                                   AS Cantidad,
       CAST(d.precio_unitario AS decimal(18,2))                     AS PrecioUnitario,
       CAST(ISNULL(d.descuento, 0) AS decimal(9,4))                 AS Descuento,
       CAST(ISNULL(p.precio, d.precio_unitario) AS decimal(18,2))   AS PrecioLista
FROM dbo.ventas AS v
INNER JOIN dbo.detalle_ventas AS d ON d.venta_id = v.venta_id
LEFT  JOIN dbo.productos      AS p ON p.producto_id = d.producto_id;</property>
                <property
                  dataType="System.String"
