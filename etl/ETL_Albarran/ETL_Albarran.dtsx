                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT p.producto_id AS ProductoID,
       CAST(LTRIM(RTRIM(p.nombre)) AS nvarchar(255))                     AS NombreProducto,
       CAST(LTRIM(RTRIM(p.descripcion)) AS nvarchar(255))                AS DescripcionOrigen,
       ISNULL(p.categoria_id, -1)                                        AS CategoriaID,
       CAST(LTRIM(RTRIM(ISNULL(cat.categoria, N'Sin categoría'))) AS nvarchar(100)) AS Categoria,
       CAST(ISNULL(p.precio, 0) AS decimal(18,2))                        AS PrecioLista
FROM dbo.productos AS p
LEFT JOIN dbo.categorias AS cat ON cat.categoria_id = p.categoria_id;</property>
