                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT DISTINCT CAST(LOWER(LTRIM(RTRIM(v.tipo_documento))) AS nvarchar(20)) AS TipoDocumentoCodigo
FROM dbo.ventas AS v
WHERE v.tipo_documento IS NOT NULL AND LTRIM(RTRIM(v.tipo_documento)) &lt;&gt; N'';</property>
