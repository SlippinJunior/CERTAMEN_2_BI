                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Specifies the position of the condition in the list of conditions that the transformation evaluates. The evaluation order is from the lowest value to the highest value."
                      name="EvaluationOrder">0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the condition that the transformation evaluates."
                      name="Expression">[ISNULL](#{Package\DFT FactVentas\SRC Ventas Detalle.Outputs[OLE DB Source Output].Columns[Fecha]}) || [ISNULL](#{Package\DFT FactVentas\SRC Ventas Detalle.Outputs[OLE DB Source Output].Columns[Cantidad]}) || [ISNULL](#{Package\DFT FactVentas\SRC Ventas Detalle.Outputs[OLE DB Source Output].Columns[PrecioUnitario]}) || #{Package\DFT FactVentas\SRC Ventas Detalle.Outputs[OLE DB Source Output].Columns[Cantidad]} &lt;= 0 || #{Package\DFT FactVentas\SRC Ventas Detalle.Outputs[OLE DB Source Output].Columns[PrecioUnitario]} &lt;= 0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the condition that the transformation evaluates."
                      expressionType="Notify"
                      name="FriendlyExpression">ISNULL(Fecha) || ISNULL(Cantidad) || ISNULL(PrecioUnitario) || Cantidad &lt;= 0 || PrecioUnitario &lt;= 0</property>
